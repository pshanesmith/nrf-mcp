{
  "name": "nrf-mcp",
  "version": "1.0.0",
  "description": "MCP server for Nordic nRF Connect SDK documentation and samples",
  "nrfSdkRef": "main",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "nrf-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "run.sh"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node test/test.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
